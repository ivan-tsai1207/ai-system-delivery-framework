{
  "name": "@ivan-tsai1207/ai-system-delivery-harness",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript package foundation for Harness v0.1.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test tests/*.test.mjs tests/unit/core/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "license": "UNLICENSED"
}
