{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness.review-assignment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assignment_id", "work_item_id", "risk_class", "review_profile",
    "maker_role", "maker_execution_ids", "reviewed_artifact", "reviewed_artifact_hash",
    "required_checks", "required_evidence", "assignment_hash"
  ],
  "properties": {
    "schema_version": { "const": "harness.review-assignment/v1" },
    "assignment_id": { "$ref": "#/$defs/nonEmptyString" },
    "work_item_id": { "$ref": "#/$defs/nonEmptyString" },
    "risk_class": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "review_profile": { "$ref": "#/$defs/reviewProfile" },
    "maker_role": { "enum": ["PRODUCT_ARCHITECT", "UX_DESIGNER", "IMPLEMENTER", "MULTIPLE"] },
    "maker_execution_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "reviewed_artifact": { "$ref": "#/$defs/artifactReference" },
    "reviewed_artifact_hash": { "$ref": "#/$defs/sha256" },
    "required_checks": { "$ref": "#/$defs/stringArray" },
    "required_evidence": { "$ref": "#/$defs/stringArray" },
    "assignment_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reviewProfile": { "enum": ["SPEC_REVIEWER", "UX_REVIEWER", "TECH_REVIEWER", "QA_REVIEWER", "SECURITY_REVIEWER", "DELIVERY_ASSURANCE_REVIEWER"] },
    "artifactReference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path"],
      "properties": {
        "kind": { "$ref": "#/$defs/nonEmptyString" }, "id": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/nonEmptyString" }, "anchor": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
